<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:padding="12dp">


    <!-- DROPDOWN MENU -->
    <Spinner
        android:id="@+id/pageSpinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#F8F8F2"
        android:popupBackground="#2B2B2B" />


    <!-- TERMINAL OUTPUT -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#2B2B2B"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Welcome to the VLANet!\n\nWith this app, you can activate any VLA*s in your local network.\n\nUse the VLANet to see how to activate and interact with VLA*s.\n\nUse the modules to take control of components of a VLA* (WIP).\n\nThis app is on Github at https://github.com/ogoudey/android-VLA_Star-activator. For all inquiries email olin.goog@gmail.com.\n\nHelp ground agents in useful, relevant, and actual space!"
            android:textColor="#F8F8F2"
            android:textSize="13sp" />

    </ScrollView>

    <!-- CHAT INPUT ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Enter message..."
            android:inputType="text"
            android:textColor="#F8F8F2"
            android:textColorHint="#888888"
            android:background="#2B2B2B"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:imeOptions="actionSend"/>

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- CONNECT BUTTON -->
    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Find Host &amp; Activate a VLA*" />

    <!-- CONNECTION PASSWORD -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Host Password"
        android:inputType="textPassword" />

</LinearLayout>